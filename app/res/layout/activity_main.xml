<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#121212">

    <!-- Top Bar: Title, Status, Battery, Sensor Age, Countdown and Settings -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="8dp">

        <!-- Top Header Row: Title, Battery, and Settings Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/textTransmitterName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Guardian Connect"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Next Calibration Countdown Badge (Compact) -->
            <TextView
                android:id="@+id/textCalCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🩸 --h"
                android:textColor="#81C784"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginEnd="10dp" />

            <!-- Sensor Lifetime Badge (Compact pictogram) -->
            <TextView
                android:id="@+id/textSensorDays"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏳ --d"
                android:textColor="#FFD54F"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginEnd="10dp" />

            <!-- Transmitter Battery Level -->
            <TextView
                android:id="@+id/textBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔋 --%"
                android:textColor="#76FF03"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginEnd="10dp" />

            <!-- Settings / Menu Button -->
            <Button
                android:id="@+id/btnSettings"
                android:layout_width="38dp"
                android:layout_height="34dp"
                android:text="⚙️"
                android:textSize="14sp"
                android:padding="0dp"
                android:backgroundTint="#2A2A2A"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Sub-header Row: Status / Live Countdown Timer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/textStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Disconnected"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />

            <!-- Live 300s Countdown Timer -->
            <TextView
                android:id="@+id/textCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main Glucose Card (Big Numbers + Small Units) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E1E1E"
        android:padding="12dp"
        android:gravity="center_horizontal"
        android:layout_marginBottom="8dp">

        <!-- Glucose Value, Trend Arrow & Unit Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <TextView
                android:id="@+id/textGlucoseMmolValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--.-"
                android:textColor="#00E676"
                android:textSize="58sp"
                android:includeFontPadding="false"
                android:textStyle="bold" />

            <!-- Large Trend Arrow -->
            <TextView
                android:id="@+id/textTrendArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="→"
                android:textColor="#00E676"
                android:textSize="38sp"
                android:includeFontPadding="false"
                android:textStyle="bold"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/textGlucoseMmolUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="mmol/L"
                android:textColor="#888888"
                android:textSize="15sp"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="10dp" />
        </LinearLayout>

        <!-- Secondary mg/dL Display -->
        <TextView
            android:id="@+id/textGlucoseMgDl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- mg/dL"
            android:textColor="#777777"
            android:textSize="14sp"
            android:layout_marginTop="-4dp"
            android:layout_marginBottom="4dp" />

        <!-- Sensor Status & Details -->
        <TextView
            android:id="@+id/textSensorDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SG: -- | Trend: -- | Status: Waiting..."
            android:textColor="#AAAAAA"
            android:textSize="12sp" />

        <!-- Quick Calibration Button (Visible when calibration is required) -->
        <Button
            android:id="@+id/btnQuickCalibrate"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:text="🩸 Enter Calibration (BG)"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="#D32F2F"
            android:visibility="gone"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Real-time Glucose Trend Chart (Fixed 230dp height so it never collapses) -->
    <LinearLayout
        android:id="@+id/chartContainer"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:background="#181818"
        android:orientation="vertical"
        android:layout_marginBottom="6dp">

        <com.openmedtronic.guardian.GlucoseChartView
            android:id="@+id/glucoseChart"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <!-- Quick Actions (Meter BG and Therapy Entry) -->
    <LinearLayout
        android:id="@+id/rowQuickActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="6dp">

        <Button
            android:id="@+id/btnQuickTherapy"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="+ 💉/🍞/🩸 Log Therapy &amp; BG"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="#1E2A38"
            android:padding="0dp" />
    </LinearLayout>

    <!-- Optional Protocol Logs Container (Hidden by default, takes remaining space) -->
    <LinearLayout
        android:id="@+id/logsContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="2dp">

        <LinearLayout
            android:id="@+id/headerLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginBottom="2dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📋 BLE Protocol Logs"
                android:textColor="#888888"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnToggleLogs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼"
                android:textColor="#888888"
                android:textSize="13sp"
                android:padding="2dp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/scrollLogs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0A0A0A"
            android:padding="4dp">

            <TextView
                android:id="@+id/textLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#B0BEC5"
                android:fontFamily="monospace"
                android:textSize="10sp"
                android:text="Client ready..." />
        </ScrollView>
    </LinearLayout>

</LinearLayout>
